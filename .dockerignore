# Host-side Python/uv artifacts — never copy into the image
**/__pycache__
**/*.py[cod]
.venv/
venv/
env
**/*.egg-info/
.pytest_cache/
.ruff_cache/
/.cache/
.idea/

# Indexed data and git repositories — bind-mounted, not baked in
**/*.db
**/repo
**/data

tags

.git
.gitignore
.gitattributes

# Editor and other backup files
**/*.swp
**/*~
**/~*
